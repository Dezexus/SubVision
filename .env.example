# SubVision — локальная конфигурация (скопируйте в .env)

REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
SHM_SIZE=2gb

# VRAM: RTX 2060 6 GB — запас для ProPainter + OpenCV CUDA + PaddleOCR
PADDLE_GPU_MEMORY_FRACTION=0.35
FLAGS_fraction_of_gpu_memory_to_use=0.35
FLAGS_allocator_strategy=auto_growth

# NVDEC hardware decode (fallback на CPU при ошибке)
USE_NVDEC=true

ALLOWED_ORIGINS=http://localhost:7860,http://127.0.0.1:7860
MAX_UPLOAD_SIZE=4294967296

# Docker Compose OpenCV CUDA arch (RTX 2060 = 7.5)
CUDA_ARCH_BIN=7.5
